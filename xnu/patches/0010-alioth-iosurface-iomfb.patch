+/*
+ * ALIOTH IOSurface kernel service implementation.
+ * Based on SweetSurface.cpp with alioth-specific adjustments.
+ */
+#if defined(ARM64_BOARD_CONFIG_ALIOTH)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOSurface.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/OSMalloc.h>
+#include <libkern/OSByteOrder.h>
+#include <mach/vm_prot.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_map.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <sys/kern_memorystatus.h>
+#include "AliothSurface.h"
+
+OSDefineMetaClassAndStructors(AliothSurfaceRoot, IOService)
+OSDefineMetaClassAndStructors(AliothSurfaceUserClient, IOUserClient)
+
+// Global surface registry
+static struct {
+    IOLock *lock;
+    OSDictionary *by_id;
+    uint32_t next_id;
+    uint32_t wired_bytes;
+} gAliothSurfaces = {0};
+
+// Selector dispatch tables
+static const IOExternalMethodDispatch gAliothSurfaceMethods[] = {
+    // sel 0: Create
+    { (IOExternalMethodAction)&AliothSurfaceUserClient::sCreate, kIOUCStructIStructO, 0, 0xA68 },
+    // sel 4: Lookup
+    { (IOExternalMethodAction)&AliothSurfaceUserClient::sLookup, kIOUCStructIStructO, 0, 0xA68 },
+    // sel 9: SetValue
+    { (IOExternalMethodAction)&AliothSurfaceUserClient::sSetValue, kIOUCStructIScalarO, 8, 4 },
+    // sel 0x0a: UpdateNonBulkValueCache
+    { (IOExternalMethodAction)&AliothSurfaceUserClient::sUpdateValueCache, kIOUCStructIStructO, 0, 4 },
+    // sel 0x0b: RemoveValue
+    { (IOExternalMethodAction)&AliothSurfaceUserClient::sRemoveValue, kIOUCStructIScalarO, 8, 4 },
+    // sel 0x13: Log
+    { (IOExternalMethodAction)&AliothSurfaceUserClient::sLog, kIOUCStructIStructO, 0, 0 },
+    // sel 0x1b: SetBulkAttachments
+    { (IOExternalMethodAction)&AliothSurfaceUserClient::sSetBulkAttachments, kIOUCStructIStructO, 0x88, 0 },
+    // sel 0x22: LookupFromMachPort
+    { (IOExternalMethodAction)&AliothSurfaceUserClient::sLookupFromMachPort, kIOUCStructIStructO, 4, 0xA68 },
+    // sel 0x23: CreateMachPort
+    { (IOExternalMethodAction)&AliothSurfaceUserClient::sCreateMachPort, kIOUCScalarIScalarO, 8, 4 },
+    { NULL, 0, 0, 0 }
+};
+
+static const IOExternalTrap gAliothSurfaceTraps[] = {
+    { (IOExternalTrapAction)&AliothSurfaceUserClient::tIncUseCount },
+    { (IOExternalTrapAction)&AliothSurfaceUserClient::tDecUseCount },
+    { (IOExternalTrapAction)&AliothSurfaceUserClient::tLock },
+    { (IOExternalTrapAction)&AliothSurfaceUserClient::tUnlock },
+    { (IOExternalTrapAction)&AliothSurfaceUserClient::tRelease },
+    { (IOExternalTrapAction)&AliothSurfaceUserClient::tReleaseFailed },
+    { NULL }
+};
+
+// --- AliothSurfaceRoot ---
+
+bool AliothSurfaceRoot::start(IOService *provider)
+{
+    if (!super::start(provider)) return false;
+
+    gAliothSurfaces.lock = IOLockAlloc();
+    gAliothSurfaces.by_id = OSDictionary::withCapacity(32);
+    gAliothSurfaces.next_id = 1;
+    gAliothSurfaces.wired_bytes = 0;
+
+    registerService();
+    IOLog("ALIOTH SURF: IOCoreSurfaceRoot registered\n");
+    return true;
+}
+
+void AliothSurfaceRoot::stop(IOService *provider)
+{
+    if (gAliothSurfaces.by_id) gAliothSurfaces.by_id->release();
+    if (gAliothSurfaces.lock) IOLockFree(gAliothSurfaces.lock);
+    super::stop(provider);
+}
+
+IOService *AliothSurfaceRoot::newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties, IOUserClient **handler)
+{
+    AliothSurfaceUserClient *client = OSTypeAlloc(AliothSurfaceUserClient);
+    if (!client) return NULL;
+    if (!client->init()) {
+        client->release();
+        return NULL;
+    }
+    *handler = client;
+    return client;
+}
+
+IOReturn AliothSurfaceRoot::registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon)
+{
+    return kIOReturnUnsupported;
+}
+
+// --- AliothSurfaceUserClient ---
+
+bool AliothSurfaceUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties)
+{
+    if (!super::initWithTask(owningTask, securityID, type, properties)) return false;
+    fTask = owningTask;
+    fSharedPage = NULL;
+    fSharedPagePhys = 0;
+    fSeed = 0;
+    fRegistered = false;
+    return true;
+}
+
+IOReturn AliothSurfaceUserClient::clientClose(void)
+{
+    if (fSharedPage) {
+        fSharedPage->release();
+        fSharedPage = NULL;
+    }
+    return super::clientClose();
+}
+
+IOReturn AliothSurfaceUserClient::externalMethod(UInt32 selector, IOExternalMethodArguments *arguments, IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+    if (selector >= (sizeof(gAliothSurfaceMethods)/sizeof(gAliothSurfaceMethods[0])) || gAliothSurfaceMethods[selector].function == NULL) {
+        return kIOReturnUnsupported;
+    }
+    return super::externalMethod(selector, arguments, &gAliothSurfaceMethods[selector], this, reference);
+}
+
+IOReturn AliothSurfaceUserClient::registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon)
+{
+    return kIOReturnUnsupported;
+}
+
+IOReturn AliothSurfaceUserClient::getTargetAndTrapForIndex(IOExternalTrap **targetP, UInt32 *indexP, UInt32 trapIndex)
+{
+    if (trapIndex >= (sizeof(gAliothSurfaceTraps)/sizeof(gAliothSurfaceTraps[0])) || gAliothSurfaceTraps[trapIndex].function == NULL) {
+        return kIOReturnUnsupported;
+    }
+    *targetP = (IOExternalTrap *)this;
+    *indexP = trapIndex;
+    return kIOReturnSuccess;
+}
+
