+/*
+ * ALIOTH IOSurface kernel service (IOCoreSurfaceRoot + IOSurfaceRootUserClient).
+ * Based on SweetSurface.cpp with alioth-specific adjustments.
+ */
+#if defined(ARM64_BOARD_CONFIG_ALIOTH)
+#ifndef _ALIOTH_SURFACE_H
+#define _ALIOTH_SURFACE_H
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOSurface.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/OSMalloc.h>
+#include <mach/vm_prot.h>
+
+#define ALIOTH_SURFACE_SEL_LIMITS        13
+#define ALIOTH_SURFACE_SEL_CREATE         0
+#define ALIOTH_SURFACE_SEL_LOOKUP         4
+#define ALIOTH_SURFACE_SEL_SETVALUE       9
+#define ALIOTH_SURFACE_SEL_UPDATEVALUE   0x0a
+#define ALIOTH_SURFACE_SEL_REMOVEVALUE   0x0b
+#define ALIOTH_SURFACE_SEL_LOOKUP_MACH   0x22
+#define ALIOTH_SURFACE_SEL_CREATE_MACH   0x23
+
+#define ALIOTH_SURFACE_TRAP_INC_USE       0
+#define ALIOTH_SURFACE_TRAP_DEC_USE       1
+#define ALIOTH_SURFACE_TRAP_LOCK          2
+#define ALIOTH_SURFACE_TRAP_UNLOCK        3
+#define ALIOTH_SURFACE_TRAP_RELEASE       4
+#define ALIOTH_SURFACE_TRAP_RELEASE_FAILED 5
+
+#define ALIOTH_SURFACE_MAX_PLANES         4
+#define ALIOTH_SURFACE_MAX_WIRED_MB      1536
+
+struct alioth_surface_state {
+    uint64_t registry_id;
+    uint16_t bound_accel_ids[2];
+    uint32_t seed;
+    uint8_t  tiled;
+    uint32_t value_gen;
+    uint32_t ycbcr_matrix;
+    uint32_t nonbulk_size;
+    uint8_t  displayable;
+    uint8_t  sysmem_only;
+    uint8_t  bulk[0x70];
+};
+
+struct alioth_surface_plane {
+    uint32_t width, height, bytes_per_row, offset, size;
+    uint16_t bytes_per_element;
+    uint8_t  element_width, element_height;
+    uint8_t  component_count;
+    uint8_t  address_format;
+    uint8_t  compression_type;
+};
+
+class AliothSurfaceRoot : public IOService {
+    OSDeclareDefaultStructors(AliothSurfaceRoot)
+public:
+    virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual IOService *newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon) APPLE_KEXT_OVERRIDE;
+};
+
+class AliothSurfaceUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AliothSurfaceUserClient)
+public:
+    virtual bool initWithTask(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn externalMethod(UInt32 selector, IOExternalMethodArguments *arguments, IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn getTargetAndTrapForIndex(IOExternalTrap **targetP, UInt32 *indexP, UInt32 trapIndex) APPLE_KEXT_OVERRIDE;
+
+protected:
+    task_t          fTask;
+    IOMemoryDescriptor *fSharedPage;
+    uint64_t        fSharedPagePhys;
+    uint32_t        fSeed;
+    bool            fRegistered;
+};
+
+#endif /* _ALIOTH_SURFACE_H */
