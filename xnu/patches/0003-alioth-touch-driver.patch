--- /dev/null
+++ b/bsd/dev/alioth_touch.c
@@ -0,0 +1,550 @@
+/*
+ * ALIOTH SE7 FIFO I2C / GT9896 Yellowstone / Focaltech 54:52 bring-up.
+ * Call once after the scheduler is running; all work runs on one thread.
+ * Requires ABL-loaded GENI I2C firmware; votes L11C through alioth_rpmh.c.
+ * No firmware/config upload or direct PMIC writes. Only IC data write:
+ * zero to GT9896's event status after reading a report.
+ */
+#if defined(ARM64_BOARD_CONFIG_ALIOTH)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int alioth_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void alioth_touch_init(void);
+
+/* GENI SE7 (QUP11) for touch I2C - from alioth DTB */
+#define TOUCH_SE_PA       0x0a840000u
+#define TOUCH_GCC_PA      0x0c400000u
+#define TOUCH_NORTH_PA    0x0a840000u  /* TLMM north */
+
+#define TOUCH_MAX         10
+#define TOUCH_GOODIX      1
+#define TOUCH_FTS         2
+
+#define SE_FW             0x00
+#define SE_STATUS         0x04
+#define SE_HW_TX          0x08
+#define SE_HW_RX          0x0c
+#define SE_CLK_SEL        0x20
+#define SE_MCLK           0x24
+#define SE_SCL            0x28
+#define SE_IRQ_EN         0x60
+#define SE_IRQ_CLR        0x64
+#define SE_IRQ_STATUS     0x68
+#define SE_DMA            0x70
+#define SE_TX_COUNT       0x80
+#define SE_RX_COUNT       0x84
+#define SE_EVENTS         0x3f
+
+#define TOUCH_GPIO_CFG(p) (0x1000 + (p) * 0x10)
+#define TOUCH_GPIO_IO(p)  (0x1004 + (p) * 0x10)
+
+static struct {
+	vm_offset_t gcc;
+	vm_offset_t gpio;
+	vm_offset_t se;
+	int kind;            /* TOUCH_GOODIX or TOUCH_FTS */
+	int irq_hint;        /* 1 = use IRQ GPIO as hint */
+	uint32_t irq_status;
+	uint32_t irq_mask;
+	int active;
+	int x[TOUCH_MAX];
+	int y[TOUCH_MAX];
+	bool dead;
+	bool started;
+} st;
+
+static void
+touch_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&st.irq_status, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static int
+touch_read(uint8_t addr, uint16_t reg, bool is_goodix, void *buf, size_t len)
+{
+	/* Simplified I2C read via GENI SE7 - to be implemented based on sweet_touch.c */
+	/* This is a stub - actual implementation needs GENI SE7 FIFO programming */
+	return ENXIO;
+}
+
+static void
+touch_report(uint32_t mask, int *x, int *y)
+{
+	for (int i = 0; i < TOUCH_MAX; ++i) {
+		if (mask & (1u << i)) {
+			sweet_hid_touch(i, 1, x[i], y[i]);
+		} else if (st.x[i] != 0 || st.y[i] != 0) {
+			sweet_hid_touch(i, 0, st.x[i], st.y[i]);
+		}
+		st.x[i] = x[i];
+		st.y[i] = y[i];
+	}
+	st.active = mask;
+}
+
+static int
+touch_goodix(void)
+{
+	/* Goodix GT9896 at 0x5d (8-bit) / 0x2e (7-bit) */
+	/* Read touch points from 0x814e */
+	return ENXIO; /* Stub */
+}
+
+static int
+touch_focaltech(void)
+{
+	/* Focaltech at 0x38 (8-bit) / 0x1c (7-bit) */
+	return ENXIO; /* Stub */
+}
+
+static bool
+touch_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	printf("ALIOTH TOUCH: se7 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx);
+	if (((fw >> 8) & 0xffu) != 3u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("ALIOTH TOUCH: need ABL-loaded I2C firmware and 32-bit FIFOs; probes skipped\n");
+		return false;
+	}
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("ALIOTH TOUCH: SE7 already busy; probes skipped\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0); /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	touch_wr(st.se, SE_CLK_SEL, 0);
+	touch_wr(st.se, SE_MCLK, (7u << 4) | 1u);
+	touch_wr(st.se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	/* Four 8-bit bytes per 32-bit word, LSB byte first (Linux packing). */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, 0x0004380eu);
+	touch_wr(st.se, 0x264, 0x000c3e0eu);
+	touch_wr(st.se, 0x284, 0x0004380eu);
+	touch_wr(st.se, 0x288, 0x000c3e0eu);
+	touch_wr(st.se, 0x80c, 1);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("ALIOTH TOUCH: inherited FIFO data; probes skipped\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(st.gpio, off);
+	if (out) {
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
+		    (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(st.gpio, off, cfg);
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("aliothtouchdelay", &delay_s, sizeof(delay_s));
+	printf("ALIOTH TOUCH: starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	printf("ALIOTH TOUCH: mapping GCC/TLMM/SE7\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
+	st.se = ml_io_map(TOUCH_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !st.se) {
+		printf("ALIOTH TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	/* Clock enable for QUP11 (GENI SE7) - to be implemented */
+	/* if (!touch_clocks() || !touch_se_init()) { goto out; } */
+	if (!touch_se_init()) {
+		goto out;
+	}
+	printf("ALIOTH TOUCH: TLMM reset=%#x irq=%#x vdd90=%#x; voting L11C through RPMh\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(8)), touch_rd(st.gpio, TOUCH_GPIO_IO(9)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(90)));
+	/* Keep the IC in reset while its rails settle; IRQ stays an input. */
+	touch_gpio(9, 0, 3, 3, false, false); /* IRQ input, 8 mA, pull-up */
+	touch_gpio(8, 0, 3, 3, true, false);   /* reset low */
+	int power_error = alioth_rpmh_vreg_enable("ldoc11", 3200);
+	if (power_error) {
+		printf("ALIOTH TOUCH: L11C RPMh enable failed %d; probes skipped\n", power_error);
+		goto out;
+	}
+	touch_gpio(90, 0, 0, 0, true, true);   /* board digital power enable */
+	touch_wait(10);
+	touch_gpio(6, 1, 0, 0, false, false);  /* qup11 SDA/SCL, 2 mA */
+	touch_gpio(7, 1, 0, 0, false, false);
+	/* Vendor GT9896 dev_confirm: reset low 2 ms, then high. */
+	touch_gpio(8, 0, 3, 3, true, false);
+	touch_wait(2);
+	touch_gpio(8, 0, 3, 3, true, true);
+	touch_wait(300);
+	uint8_t gid[12] = {0}, fid1 = 0, fid2 = 0;
+	int ge = touch_read(0x5d, 0x4022, true, gid, sizeof(gid));
+	printf("ALIOTH TOUCH: probe 0x5d err=%d pid=%02x%02x%02x%02x fw=%02x.%02x.%02x.%02x irq=%#x\n",
+	    ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
+	int fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
+	int fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
+	printf("ALIOTH TOUCH: probe 0x38 err=%d/%d chip-id=%02x:%02x irq=%#x\n",
+	    fe1, fe2, fid1, fid2, st.irq_status);
+	bool goodix = !ge && gid[0] == '9' && gid[1] == '8' && gid[2] == '9' && gid[3] == '6';
+	bool fts = !fe1 && !fe2 && fid1 == 0x54 && fid2 == 0x52;
+	if (st.dead || goodix == fts) {
+		printf("ALIOTH TOUCH: no unique supported IC (goodix=%d fts=%d dead=%d); stopping\n",
+		    goodix, fts, st.dead);
+		goto out;
+	}
+	st.kind = goodix ? TOUCH_GOODIX : TOUCH_FTS;
+	printf("ALIOTH TOUCH: selected %s, 1080x2400, poll=10ms irq-hint=%d\n",
+	    goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", st.irq_hint);
+	unsigned errors = 0, ticks = 0;
+	while (!st.dead) {
+		if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u) ||
+		    (++ticks % 10u) == 0) {
+			int err = st.kind == TOUCH_GOODIX ? touch_goodix() : touch_focaltech();
+			if (err) {
+				if ((errors++ % 100u) == 0) {
+					printf("ALIOTH TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
+				}
+				if (errors == 10) {
+					touch_report(0, st.x, st.y);
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		touch_wait(10);
+	}
+	touch_report(0, st.x, st.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+alioth_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (st.started) {
+		return;
+	}
+	st.started = true;
+	(void)PE_parse_boot_argn("aliothtouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("aliothtouchirq", &st.irq_hint, sizeof(st.irq_hint));
+	if (!enabled) {
+		printf("ALIOTH TOUCH: disabled (aliothtouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("ALIOTH TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_ALIOTH */
