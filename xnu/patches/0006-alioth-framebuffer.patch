+/*
+ * ALIOTH framebuffer driver for Poco F3 (SM7150).
+ * Presents iPhone X display size (1125x2436) on 1080x2400 panel.
+ * Based on SweetFramebuffer.cpp with alioth-specific adjustments.
+ */
+#if defined(ARM64_BOARD_CONFIG_ALIOTH)
+#include <IOKit/IOLib.h>
+#include <IOKit/graphics/IOFramebuffer.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOMemoryMap.h>
+#include <IOKit/IOSurface.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <mach/machine.h>
+#include <kern/kalloc.h>
+#include <vm/vm_kern.h>
+
+#define ALIOTH_FB_NOTIFY_TYPES    8
+#define ALIOTH_FB_NOTIFY_VSYNC    5
+#define ALIOTH_FB_VSYNC_US        16667  /* 60 Hz */
+#define ALIOTH_FB_DOT_PITCH       458    /* ppi, as the iPhone X panel */
+#define ALIOTH_FB_LOGICAL_W       1125
+#define ALIOTH_FB_LOGICAL_H       2436
+#define ALIOTH_FB_FORMAT_BGRA     0x42475241
+
+class IOMobileFramebuffer : public IOService {
+    OSDeclareDefaultStructors(IOMobileFramebuffer)
+
+public:
+    uint64_t      fPhys;
+    uint32_t      fWidth, fHeight, fRowBytes;
+    uint32_t      fLogicalW, fLogicalH;     /* size reported to userland */
+    int32_t       fOffX, fOffY;             /* logical origin of the panel */
+    uintptr_t     fPixels;          /* kernel mapping of the panel memory */
+    IOMemoryMap  *fMap;
+    IOSurface    *fSurface;         /* the panel memory as an IOSurface */
+    IOLock       *fLock;
+    OSArray      *fClients;
+    bool          fNotified[ALIOTH_FB_NOTIFY_TYPES];
+
+    virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn getDisplayMode(IODisplayModeID *mode, IOIndex depth) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn setDisplayMode(IODisplayModeID mode, IOIndex depth) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn getAttributeForConnection(IOIndex connect, IODisplayAttributeID attr, void *value) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn setAttributeForConnection(IOIndex connect, IODisplayAttributeID attr, void *value) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn getInformationForDisplayMode(IODisplayModeID mode, IODisplayModeInformation *info) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn notifyServerConnect(IODisplayServer *server, IOIndex connect) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn notifyServerDisconnect(IODisplayServer *server, IOIndex connect) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn getPixelInformation(IOIndex connect, IOSurfaceID surface_id, uint32_t *outFlags, uint32_t *outBytesPerRow, uint32_t *outBytesPerElement, uint32_t *outWidth, uint32_t *outHeight, uint32_t *outPixelFormat) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn getDisplayVendorAttributes(uint32_t *attr, uint32_t maxAttrs) APPLE_KEXT_OVERRIDE;
+    virtual void syncDisplay() APPLE_KEXT_OVERRIDE;
+    virtual IOReturn presentDisplay(uint64_t frame, uint64_t *timestamp) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn getPanelInfo(uint32_t *width, uint32_t *height, uint32_t *stride, uint32_t *format) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOMobileFramebuffer, IOService)
+
+bool
+IOMobileFramebuffer::start(IOService *provider)
+{
+    DTEntry entry;
+    if (DTLookupEntry(NULL, "/chosen", &entry) != kSuccess) {
+        IOLog("ALIOTH FB: no /chosen\n");
+        return false;
+    }
+
+    uint64_t fbPhys = 0;
+    uint32_t fbSize = 0;
+    if (DTGetProperty(entry, "boot-args", NULL, NULL) == kSuccess) {
+        /* Framebuffer info passed via boot args or device tree */
+    }
+
+    /* Get framebuffer from boot args (set by shim) */
+    boot_args *ba = (boot_args *)PE_state.bootArgs;
+    if (ba && ba->Video.v_baseAddr) {
+        fPhys = ba->Video.v_baseAddr;
+        fWidth = ba->Video.v_width;
+        fHeight = ba->Video.v_height;
+        fRowBytes = ba->Video.v_rowBytes;
+    } else {
+        IOLog("ALIOTH FB: no boot framebuffer\n");
+        return false;
+    }
+
+    int native = 0;
+    PE_parse_boot_argn("aliothfb_native", &native, sizeof(native));
+    fLogicalW = fWidth;
+    fLogicalH = fHeight;
+    if (!native && fWidth <= ALIOTH_FB_LOGICAL_W && fHeight <= ALIOTH_FB_LOGICAL_H) {
+        fLogicalW = ALIOTH_FB_LOGICAL_W;
+        fLogicalH = ALIOTH_FB_LOGICAL_H;
+    }
+    fOffX = (int32_t)(fLogicalW - fWidth) / 2;
+    fOffY = (int32_t)(fLogicalH - fHeight) / 2;
+
+    fLock = IOLockAlloc();
+    fClients = OSArray::withCapacity(4);
+
+    /* Map the framebuffer */
+    fMap = IOMemoryMap::withPhysicalAddress(fPhys, FB_SIZE, kIODirectionOutIn);
+    if (!fMap) {
+        IOLog("ALIOTH FB: failed to map framebuffer\n");
+        return false;
+    }
+    fPixels = (uintptr_t)fMap->getVirtualAddress();
+
+    /* Create IOSurface for the framebuffer */
+    fSurface = IOSurfaceCreate(fWidth, fHeight, 32, kIOSurfacePixelFormat32BGRA, 0, 0, 0, NULL);
+    if (!fSurface) {
+        IOLog("ALIOTH FB: failed to create IOSurface\n");
+        return false;
+    }
+
+    /* Register with IOMobileFramebuffer */
+    setProperty("IOMobileFramebuffer", true);
+    setProperty("builtin", true);
+    setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
+    registerService();
+
+    IOLog("ALIOTH FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
+        fWidth, fHeight, fRowBytes, fPhys, fSurface->getID(), fLogicalW, fLogicalH);
+    return true;
+}
+
+void
+IOMobileFramebuffer::stop(IOService *provider)
+{
+    if (fSurface) fSurface->release();
+    if (fMap) fMap->release();
+    if (fLock) IOLockFree(fLock);
+    if (fClients) fClients->release();
+    super::stop(provider);
+}
+
+IOReturn
+IOMobileFramebuffer::getDisplayMode(IODisplayModeID *mode, IOIndex depth)
+{
+    *mode = 0;
+    return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebuffer::setDisplayMode(IODisplayModeID mode, IOIndex depth)
+{
+    return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebuffer::getAttributeForConnection(IOIndex connect, IODisplayAttributeID attr, void *value)
+{
+    switch (attr) {
+    case kDisplayBrightness:
+        *(float *)value = 1.0f;
+        return kIOReturnSuccess;
+    case kDisplayHardwareCanChangeBrightness:
+        *(bool *)value = false;
+        return kIOReturnSuccess;
+    }
+    return kIOReturnUnsupported;
+}
+
+IOReturn
+IOMobileFramebuffer::setAttributeForConnection(IOIndex connect, IODisplayAttributeID attr, void *value)
+{
+    return kIOReturnUnsupported;
+}
+
+IOReturn
+IOMobileFramebuffer::getInformationForDisplayMode(IODisplayModeID mode, IODisplayModeInformation *info)
+{
+    info->nominalWidth = fLogicalW;
+    info->nominalHeight = fLogicalH;
+    info->refreshRate = 60.0;
+    info->maxDepthIndex = 0;
+    return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebuffer::notifyServerConnect(IODisplayServer *server, IOIndex connect)
+{
+    IOLockLock(fLock);
+    if (fClients->getCount() == 0) {
+        /* First client - enable vsync notifications */
+    }
+    fClients->setObject(server);
+    IOLockUnlock(fLock);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebuffer::notifyServerDisconnect(IODisplayServer *server, IOIndex connect)
+{
+    IOLockLock(fLock);
+    fClients->removeObject(server);
+    if (fClients->getCount() == 0) {
+        /* Last client - disable vsync notifications */
+    }
+    IOLockUnlock(fLock);
+    return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebuffer::getPixelInformation(IOIndex connect, IOSurfaceID surface_id, uint32_t *outFlags, uint32_t *outBytesPerRow, uint32_t *outBytesPerElement, uint32_t *outWidth, uint32_t *outHeight, uint32_t *outPixelFormat)
+{
+    *outFlags = 0;
+    *outBytesPerRow = fRowBytes;
+    *outBytesPerElement = 4;
+    *outWidth = fLogicalW;
+    *outHeight = fLogicalH;
+    *outPixelFormat = ALIOTH_FB_FORMAT_BGRA;
+    return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebuffer::getDisplayVendorAttributes(uint32_t *attr, uint32_t maxAttrs)
+{
+    return kIOReturnUnsupported;
+}
+
+void
+IOMobileFramebuffer::syncDisplay()
+{
+    /* No-op for now */
+}
+
+IOReturn
+IOMobileFramebuffer::presentDisplay(uint64_t frame, uint64_t *timestamp)
+{
+    /* Panel is always on (DSC video mode), no kick needed */
+    if (timestamp) {
+        *timestamp = mach_absolute_time();
+    }
+    return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebuffer::getPanelInfo(uint32_t *width, uint32_t *height, uint32_t *stride, uint32_t *format)
+{
+    *width = fLogicalW;
+    *height = fLogicalH;
+    *stride = fRowBytes;
+    *format = ALIOTH_FB_FORMAT_BGRA;
+    return kIOReturnSuccess;
+}
+#endif /* ARM64_BOARD_CONFIG_ALIOTH */
