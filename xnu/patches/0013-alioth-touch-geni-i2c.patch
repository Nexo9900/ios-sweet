+/* Goodix GT9896 read: 0x814e = status + 10 fingers * 8 bytes */
+static int
+touch_goodix_read(void)
+{
+	uint8_t buf[81] = {0};
+	int err = touch_read_geni(0x5d, 0x814e, true, buf, sizeof(buf));
+	if (err) return err;
+	uint8_t status = buf[0];
+	int touch_count = status & 0x0f;
+	if (touch_count == 0 || touch_count > 10) {
+		/* No touches - write 0 to status to clear interrupt */
+		uint8_t zero = 0;
+		touch_write_geni(0x5d, 0x814e, true, &zero, 1);
+		return 0;
+	}
+	uint32_t mask = 0;
+	for (int i = 0; i < touch_count && i < 10; ++i) {
+		uint8_t *p = buf + 1 + i * 8;
+		int id = p[0] & 0x0f;
+		if (id >= 10) continue;
+		int x = p[1] | (p[2] << 8);
+		int y = p[3] | (p[4] << 8);
+		st.x[id] = x;
+		st.y[id] = y;
+		mask |= (1u << id);
+	}
+	/* Clear interrupt by writing 0 to status */
+	uint8_t zero = 0;
+	touch_write_geni(0x5d, 0x814e, true, &zero, 1);
+	touch_report(mask, st.x, st.y);
+	return 0;
+}
+
+/* Focaltech read: 0x02 = touch data */
+static int
+touch_focaltech_read(void)
+{
+	uint8_t buf[64] = {0};
+	int err = touch_read_geni(0x38, 0x02, false, buf, sizeof(buf));
+	if (err) return err;
+	int touch_count = buf[1] & 0x0f;
+	if (touch_count == 0 || touch_count > 10) {
+		return 0;
+	}
+	uint32_t mask = 0;
+	for (int i = 0; i < touch_count && i < 10; ++i) {
+		uint8_t *p = buf + 2 + i * 6;
+		int id = p[2] >> 4;
+		if (id >= 10) continue;
+		int x = p[0] | ((p[1] & 0x0f) << 8);
+		int y = p[2] & 0x0f | (p[3] << 4);
+		st.x[id] = x;
+		st.y[id] = y;
+		mask |= (1u << id);
+	}
+	touch_report(mask, st.x, st.y);
+	return 0;
+}
