+/*
+ * ALIOTH HID event services - IOHIDEventService for buttons and touch.
+ * Based on SweetHID.cpp with alioth-specific adjustments.
+ */
+#if defined(ARM64_BOARD_CONFIG_ALIOTH)
+#ifndef _ALIOTH_HID_H
+#define _ALIOTH_HID_H
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/hid/IOHIDEventService.h>
+#include <IOKit/hid/IOHIDEvent.h>
+#include <libkern/OSByteOrder.h>
+
+// Key codes (matching sweet_hid_key)
+enum {
+    ALIOTH_HID_KEY_POWER = 0,
+    ALIOTH_HID_KEY_VOLUP = 1,
+    ALIOTH_HID_KEY_VOLDOWN = 2,
+    ALIOTH_HID_KEY_HOME = 3,
+};
+
+// HID usage pages
+#define HID_USAGE_PAGE_CONSUMER   0x0C
+#define HID_USAGE_CONSUMER_POWER  0x30
+#define HID_USAGE_CONSUMER_VOLUP  0xE9
+#define HID_USAGE_CONSUMER_VOLDN  0xEA
+#define HID_USAGE_CONSUMER_MENU   0x40
+
+// Digitizer collections
+#define ALIOTH_TOUCH_FINGERS      10
+#define ALIOTH_TOUCH_EDGE_PX      48
+#define ALIOTH_TOUCH_LOGICAL_W    1080
+#define ALIOTH_TOUCH_LOGICAL_H    2400
+
+class AliothHIDButtons : public IOHIDEventService {
+    OSDeclareDefaultStructors(AliothHIDButtons)
+public:
+    virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn handleStart(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn handleStop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual bool matchPropertyTable(OSDictionary *table, SInt32 *score) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+class AliothHIDTouch : public IOHIDEventService {
+    OSDeclareDefaultStructors(AliothHIDTouch)
+public:
+    virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn handleStart(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn handleStop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual bool matchPropertyTable(OSDictionary *table, SInt32 *score) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+
+protected:
+    IOLock *fLock;
+    int fLogicalW, fLogicalH;
+    bool fDown[ALIOTH_TOUCH_FINGERS];
+    bool fEdge[ALIOTH_TOUCH_FINGERS];
+    IOFixed fX[ALIOTH_TOUCH_FINGERS];
+    IOFixed fY[ALIOTH_TOUCH_FINGERS];
+};
+
+// C hooks called from bsd/dev/alioth_keys.c and bsd/dev/alioth_touch.c
+extern "C" {
+    void alioth_hid_key(int key, int down);
+    void alioth_hid_touch(int finger, int down, int x, int y);
+}
+
+#endif /* _ALIOTH_HID_H */
+#endif /* ARM64_BOARD_CONFIG_ALIOTH */
