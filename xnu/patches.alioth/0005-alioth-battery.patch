+/*
+ * ALIOTH battery / power source via PM6150L FG (Fuel Gauge) and RPMh.
+ * Provides IOPMPowerSource for iOS battery UI.
+ * Reads battery status via SPMI from PM6150L FG (SID 2 typically).
+ */
+#if defined(ARM64_BOARD_CONFIG_ALIOTH)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kernel.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern bool alioth_spmi_read(uint8_t sid, uint16_t addr, uint8_t *out);
+void alioth_battery_init(void);
+
+/* PM6150L FG (Fuel Gauge) SPMI SID - typically 2 */
+#define FG_SID          2
+#define FG_ADDR_SOC     0x0c    /* State of Charge */
+#define FG_ADDR_VOLT    0x0e    /* Voltage */
+#define FG_ADDR_TEMP    0x10    /* Temperature */
+#define FG_ADDR_STATUS  0x12    /* Charging status */
+#define FG_ADDR_CAP     0x14    /* Capacity */
+
+static struct {
+	int soc;           /* 0-100 */
+	int voltage_mv;    /* mV */
+	int temp_c;        /* 0.1 deg C */
+	bool charging;
+	bool present;
+	bool started;
+} bat;
+
+static void
+bat_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(10000, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&bat.soc, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+bat_poll(void)
+{
+	uint8_t v;
+	/* Read SOC (0-100) */
+	if (alioth_spmi_read(FG_SID, FG_ADDR_SOC, &v)) {
+		bat.soc = v;
+		bat.present = true;
+	} else {
+		bat.present = false;
+		return;
+	}
+	/* Read voltage */
+	if (alioth_spmi_read(FG_SID, FG_ADDR_VOLT, &v)) {
+		bat.voltage_mv = v * 20; /* LSB = 20mV typically */
+	}
+	/* Read temperature */
+	if (alioth_spmi_read(FG_SID, FG_ADDR_TEMP, &v)) {
+		bat.temp_c = (int)v * 10 - 2731; /* Convert to 0.1 deg C from Kelvin */
+	}
+	/* Read status */
+	if (alioth_spmi_read(FG_SID, FG_ADDR_STATUS, &v)) {
+		bat.charging = (v & 0x1); /* Bit 0 = charging */
+	}
+}
+
+static void
+bat_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	while (1) {
+		bat_poll();
+		bat_wait();
+	}
+}
+
+/* IOPMPowerSource compatibility - called from SweetBattery.cpp equivalent */
+int
+alioth_battery_get_soc(void)
+{
+	return bat.present ? bat.soc : 100; /* Default 100% if not readable */
+}
+
+int
+alioth_battery_get_voltage(void)
+{
+	return bat.present ? bat.voltage_mv : 4200; /* Default 4.2V */
+}
+
+int
+alioth_battery_get_temp(void)
+{
+	return bat.present ? bat.temp_c : 250; /* Default 25.0C */
+}
+
+bool
+alioth_battery_is_charging(void)
+{
+	return bat.present ? bat.charging : false;
+}
+
+bool
+alioth_battery_is_present(void)
+{
+	return bat.present;
+}
+
+void
+alioth_battery_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (bat.started) return;
+	bat.started = true;
+	(void)PE_parse_boot_argn("aliothbattery", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("ALIOTH BATTERY: disabled (aliothbattery=0)\n");
+		return;
+	}
+	/* Initial poll */
+	bat_poll();
+	kern_return_t kr = kernel_thread_start(bat_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("ALIOTH BATTERY: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_ALIOTH */
 
--- /dev/null
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -0,0 +1,120 @@
+/*
+ * ALIOTH Battery IOKit driver - provides IOPMPowerSource for iOS.
+ * Mirrors the SweetBattery.cpp interface but for alioth.
+ */
+#if defined(ARM64_BOARD_CONFIG_ALIOTH)
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <IOKit/IOService.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+
+extern "C" {
+    extern int alioth_battery_get_soc(void);
+    extern int alioth_battery_get_voltage(void);
+    extern int alioth_battery_get_temp(void);
+    extern bool alioth_battery_is_charging(void);
+    extern bool alioth_battery_is_present(void);
+}
+
+class AliothBattery : public IOPMPowerSource {
+    OSDeclareDefaultStructors(AliothBattery)
+
+public:
+    virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+    // IOPMPowerSource overrides
+    virtual int getCapacity() APPLE_KEXT_OVERRIDE;
+    virtual int getVoltage() APPLE_KEXT_OVERRIDE;
+    virtual int getCurrent() APPLE_KEXT_OVERRIDE;
+    virtual int getAverageCurrent() APPLE_KEXT_OVERRIDE;
+    virtual int getTimeRemaining() APPLE_KEXT_OVERRIDE;
+    virtual int getTemperature() APPLE_KEXT_OVERRIDE;
+    virtual bool getExternalConnected() APPLE_KEXT_OVERRIDE;
+    virtual bool getFullyCharged() APPLE_KEXT_OVERRIDE;
+    virtual bool getBatteryPresent() APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AliothBattery, IOPMPowerSource)
+
+bool
+AliothBattery::start(IOService *provider)
+{
+    if (!IOPMPowerSource::start(provider)) {
+        return false;
+    }
+    registerService();
+    return true;
+}
+
+void
+AliothBattery::stop(IOService *provider)
+{
+    IOPMPowerSource::stop(provider);
+}
+
+int
+AliothBattery::getCapacity()
+{
+    return alioth_battery_get_soc();
+}
+
+int
+AliothBattery::getVoltage()
+{
+    return alioth_battery_get_voltage(); /* mV */
+}
+
+int
+AliothBattery::getCurrent()
+{
+    return 0; /* Not implemented */
+}
+
+int
+AliothBattery::getAverageCurrent()
+{
+    return 0;
+}
+
+int
+AliothBattery::getTimeRemaining()
+{
+    int soc = alioth_battery_get_soc();
+    if (soc <= 0) return 0;
+    if (alioth_battery_is_charging()) return IOPM_TIME_REMAINING_UNKNOWN;
+    return soc * 60; /* Rough estimate: 1% = 1 minute */
+}
+
+int
+AliothBattery::getTemperature()
+{
+    return alioth_battery_get_temp(); /* 0.1 deg C */
+}
+
+bool
+AliothBattery::getExternalConnected()
+{
+    return alioth_battery_is_charging();
+}
+
+bool
+AliothBattery::getFullyCharged()
+{
+    return alioth_battery_get_soc() >= 100;
+}
+
+bool
+AliothBattery::getBatteryPresent()
+{
+    return alioth_battery_is_present();
+}
+#endif /* ARM64_BOARD_CONFIG_ALIOTH */
