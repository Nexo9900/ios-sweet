--- /dev/null
+++ b/bsd/dev/alioth_rpmh.c
@@ -0,0 +1,380 @@
+/*
+ * ALIOTH PM6150L RPMh bring-up; for L11C and other regulator votes.
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ * Addresses from alioth live DT.
+ */
+#if defined(ARM64_BOARD_CONFIG_ALIOTH)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int alioth_rpmh_vreg_enable(const char *res, unsigned mv);
+
+/* Live downstream DT has two positional reg entries, no reg-names.
+ * RPMh RSC (Resource State Controller) for PM6150L
+ */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DICT_PA      0x0c3f000cu
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+
+static struct {
+	vm_offset_t rsc;
+	vm_offset_t tcs;
+	vm_offset_t dict;
+	uint32_t dict_version;
+	uint32_t dict_count;
+	bool ready;
+} rh;
+
+static inline uint32_t
+rh_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+rh_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* Find resource index in RPMh dictionary by name */
+static int
+rh_find_resource(const char *name)
+{
+	if (!rh.dict || rh.dict_count == 0) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < rh.dict_count; ++i) {
+		uint32_t off = rh_rd(rh.dict, 0x10 + i * 0x10);
+		uint32_t len = rh_rd(rh.dict, 0x14 + i * 0x10);
+		if (off == 0 || len == 0) continue;
+		char *str = (char *)(rh.dict + off);
+		if (strcmp(str, name) == 0) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+/* Write a TCS command for a resource */
+static int
+rh_tcs_write(unsigned tcs_idx, unsigned res_idx, uint32_t msg_id, uint32_t addr, uint32_t data)
+{
+	vm_offset_t tcs = rh.tcs + tcs_idx * RH_TCS_STRIDE;
+	rh_wr(tcs, RH_MSGID, msg_id);
+	rh_wr(tcs, RH_ADDR, addr);
+	rh_wr(tcs, RH_DATA, data);
+	rh_wr(tcs, RH_CONTROL, RH_TRIGGER | RH_AMC_EN);
+	for (int i = 0; i < 1000; ++i) {
+		if ((rh_rd(tcs, RH_CMD_STATUS) & 1u) == 0) {
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+/* Enable a regulator voltage via RPMh ACTIVE TCS */
+int
+alioth_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	if (!rh.ready) {
+		return ENXIO;
+	}
+	int idx = rh_find_resource(res);
+	if (idx < 0) {
+		printf("ALIOTH RPMh: resource '%s' not found\n", res);
+		return ENOENT;
+	}
+	/* Voltage in uV, RPMh expects corner index. 
+	 * For LDO: corner = mv / 100 (approximate).
+	 * This is simplified - real implementation needs corner mapping from DT.
+	 */
+	unsigned corner = (mv + 50) / 100;
+	if (corner > 255) corner = 255;
+
+	/* Write to ACTIVE TCS (index RH_ACTIVE_N) for this resource */
+	uint32_t msg_id = (RH_DRV << 24) | ((uint32_t)idx << 8) | 0x01; /* NRT write */
+	int err = rh_tcs_write(RH_ACTIVE_N, idx, msg_id, 0, corner);
+	if (err) {
+		printf("ALIOTH RPMh: enable '%s' failed %d\n", res, err);
+	}
+	return err;
+}
+
+void
+alioth_rpmh_init(void)
+{
+	if (rh.ready) {
+		return;
+	}
+	rh.rsc = ml_io_map(RH_RSC_PA, 0x1000);
+	rh.tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	rh.dict = ml_io_map(RH_DICT_PA, 0x1000);
+	if (!rh.rsc || !rh.tcs || !rh.dict) {
+		printf("ALIOTH RPMh: MMIO mapping failed\n");
+		return;
+	}
+	rh.dict_version = rh_rd(rh.dict, 0);
+	rh.dict_count = rh_rd(rh.dict, 4);
+	if (rh.dict_version != 1 || rh.dict_count > 256) {
+		printf("ALIOTH RPMh: bad dict version=%u count=%u\n", rh.dict_version, rh.dict_count);
+		return;
+	}
+	/* Enable the RPMh controller */
+	rh_wr(rh.rsc, RH_ENABLE, 1);
+	rh_wr(rh.rsc, RH_IRQ_EN, 0); /* polling mode */
+	rh.ready = true;
+	printf("ALIOTH RPMh: initialized, dict v%u %u resources\n", rh.dict_version, rh.dict_count);
+}
+#endif /* ARM64_BOARD_CONFIG_ALIOTH */
 
--- /dev/null
+++ b/bsd/dev/alioth_spmi.c
@@ -0,0 +1,200 @@
+/*
+ * ALIOTH SPMI (System Power Management Interface) for PM6150L access.
+ * Used for reading PMIC registers (keys, battery, etc.) - write not needed.
+ * SPMI controller at 0x0c440000 (same as sweet).
+ */
+#if defined(ARM64_BOARD_CONFIG_ALIOTH)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void alioth_spmi_init(void);
+
+#define SPMI_CORE_PA    0x0c440000u
+#define SPMI_OBS_PA     0x0e600000u
+#define SPMI_CNFG_PA    0x0c40a000u
+
+static vm_offset_t spmi_core, spmi_obs, spmi_cnfg;
+static uint32_t spmi_version, spmi_apid_count;
+static bool spmi_ready;
+
+static inline uint32_t
+spmi_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static uint16_t
+spmi_find_apid(uint16_t ppid)
+{
+	uint16_t found = 0xffff;
+	for (uint32_t i = 0; i < spmi_apid_count; ++i) {
+		uint32_t map = spmi_rd(spmi_core, 0x900 + 4 * i);
+		if (map == 0 || ((map >> 8) & 0xfff) != ppid) continue;
+		uint32_t owner = spmi_rd(spmi_cnfg, 0x700 + 4 * i) & 7;
+		if (found == 0xffff || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+bool
+alioth_spmi_read(uint8_t sid, uint16_t addr, uint8_t *out)
+{
+	if (!spmi_ready) return false;
+	uint16_t apid = spmi_find_apid(sid);
+	if (apid == 0xffff) return false;
+	uint32_t off = 0x80 * apid;
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xff) << 4); /* EXT_READL */
+	*(volatile uint32_t *)(spmi_obs + off) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (int i = 0; i < 1000; ++i) {
+		uint32_t status = spmi_rd(spmi_obs, off + 0x08);
+		if (status & 1) {
+			if (status & 0xe) return false;
+			*out = (uint8_t)spmi_rd(spmi_obs, off + 0x18);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+void
+alioth_spmi_init(void)
+{
+	if (spmi_ready) return;
+	spmi_core = ml_io_map(SPMI_CORE_PA, 0x2000);
+	spmi_cnfg = ml_io_map(SPMI_CNFG_PA, 0x1000);
+	spmi_obs = ml_io_map(SPMI_OBS_PA, 0x10000);
+	if (!spmi_core || !spmi_cnfg || !spmi_obs) {
+		printf("ALIOTH SPMI: MMIO mapping failed\n");
+		return;
+	}
+	spmi_version = spmi_rd(spmi_core, 0);
+	spmi_apid_count = spmi_rd(spmi_core, 4) & 0x7ff;
+	if (spmi_version < 0x50000000 || spmi_version >= 0x70000000 ||
+	    spmi_apid_count == 0 || spmi_apid_count > 512) {
+		printf("ALIOTH SPMI: unsupported version=%#x apids=%u\n", spmi_version, spmi_apid_count);
+		return;
+	}
+	spmi_ready = true;
+	printf("ALIOTH SPMI: arb=%#x apids=%u\n", spmi_version, spmi_apid_count);
+}
+#endif /* ARM64_BOARD_CONFIG_ALIOTH */
